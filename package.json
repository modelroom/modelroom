{
  "name": "modelroom",
  "version": "0.0.6",
  "description": "A local workspace to design UI screens with any coding agent — one room per screen: BRIEF, SPEC, BEHAVIOUR and the artifact.",
  "keywords": [
    "agent-agnostic",
    "ai-agents",
    "claude-code",
    "codex",
    "coding-agents",
    "design",
    "design-system",
    "design-workflow",
    "live-preview",
    "opencode",
    "spec-driven",
    "ui-design"
  ],
  "homepage": "https://github.com/modelroom/modelroom#readme",
  "bugs": {
    "url": "https://github.com/modelroom/modelroom/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modelroom/modelroom.git"
  },
  "bin": {
    "modelroom": "dist/bin/modelroom.js"
  },
  "files": [
    "dist",
    "ui",
    "templates",
    "examples",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "./dist/lib/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/server.d.ts",
      "default": "./dist/lib/server.js"
    }
  },
  "scripts": {
    "dev": "node --watch bin/modelroom.ts",
    "modelroom": "node bin/modelroom.ts",
    "start": "node bin/modelroom.ts",
    "build": "npm run build:server && npm run build:web && npm run build:css",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "node scripts/build-web.mjs",
    "build:css": "esbuild src/modelroom.css --bundle --minify --outfile=ui/modelroom.css --target=es2022",
    "dev:web": "node scripts/build-web.mjs --dev --watch",
    "dev:css": "esbuild src/modelroom.css --bundle --outfile=ui/modelroom.css --watch --target=es2022",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run lint:types && npm run format:check && npm run typecheck && npm test && npm run build",
    "verify:ui": "node scripts/verify-ui.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lefthook": "^2.2.2",
    "lucide-react": "^1.59.0",
    "markdown-it": "^15.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^3.0.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
