{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "package-lock.json",
    "ui/**",
    "templates/**",
    "docs/**",
    "**/*.md"
  ]
}
